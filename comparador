<div class="cgm-overlay" id="cgmOverlay" role="dialog" aria-modal="true" aria-labelledby="cgmTitle">
  <div class="cgm-modal">

    <div class="cgm-logo">
      <div class="cgm-logo-box">C</div>
      <div class="cgm-logo-brand">CDT<span>go</span></div>
    </div>

    <!-- Entidad destino (se llena por JS) -->
    <div class="cgm-dest">
      <div class="cgm-dest-ico">🏦</div>
      <div>
        <div class="cgm-dest-label">Abriendo CDT en</div>
        <div class="cgm-dest-name" id="cgmEntidad">—</div>
      </div>
      <div class="cgm-dest-tasa" id="cgmTasaPlazo">—</div>
    </div>

    <!-- Vista formulario -->
    <div id="cgmFormView">
      <h2 class="cgm-title" id="cgmTitle">¿Quieres que te avisemos cuando estés cerca del vencimiento?</h2>
      <p class="cgm-sub">
        Déjanos tus datos y CDTgo te avisa con anticipación para que decidas si renovar, cambiar de entidad o retirar tu dinero <strong>sin perder ni un día de rendimiento</strong>.
      </p>

      <div class="cgm-form">
        <div class="cgm-row">
          <div class="cgm-field">
            <label for="cgmNombre">Nombre</label>
            <input id="cgmNombre" type="text" placeholder="Tu nombre" autocomplete="given-name">
          </div>
          <div class="cgm-field">
            <label for="cgmApellido">Apellido</label>
            <input id="cgmApellido" type="text" placeholder="Apellido" autocomplete="family-name">
          </div>
        </div>
        <div class="cgm-field">
          <label for="cgmEmail">Correo electrónico</label>
          <input id="cgmEmail" type="email" placeholder="correo@ejemplo.com" autocomplete="email">
        </div>
        <div class="cgm-field">
          <label for="cgmCelular">Celular (opcional)</label>
          <input id="cgmCelular" type="tel" placeholder="300 000 0000" autocomplete="tel">
        </div>
        <div class="cgm-row">
          <div class="cgm-field">
            <label for="cgmMonto">Monto a invertir</label>
            <input id="cgmMonto" type="text" placeholder="Ej: $ 5.000.000" inputmode="numeric">
          </div>
          <div class="cgm-field">
            <label for="cgmPlazo">Plazo del CDT</label>
            <input id="cgmPlazo" type="text" readonly>
          </div>
        </div>
      </div>

      <div class="cgm-consents">
        <label class="cgm-consent">
          <input type="checkbox" id="cgmC1" checked>
          Acepto que CDTgo guarde mis datos para enviarme el recordatorio de vencimiento de mi CDT.
        </label>
        <label class="cgm-consent">
          <input type="checkbox" id="cgmC2" checked>
          Acepto recibir comunicaciones de CDTgo sobre nuevas tasas, entidades aliadas y oportunidades de inversión. Puedo darme de baja en cualquier momento.
        </label>
        <label class="cgm-consent">
          <input type="checkbox" id="cgmC3" checked>
          Entiendo que las tasas del comparador son un referente basado en datos de la SFC y no constituyen una oferta vinculante. La tasa definitiva la fija la entidad al momento de apertura del CDT.
        </label>
        <p class="cgm-habeas">Tus datos están protegidos bajo la Ley 1581 de 2012 (Habeas Data). No los compartimos con terceros.</p>
      </div>

      <div class="cgm-actions">
        <button class="cgm-btn-primary" id="cgmBtnGuardar">Guardar y continuar al banco ↗</button>
        <button class="cgm-btn-skip" id="cgmBtnSaltar">Continuar sin registrarme</button>
      </div>
    </div>

    <!-- Vista confirmación -->
    <div class="cgm-confirm" id="cgmConfirmView">
      <div class="cgm-check">✓</div>
      <h3>¡Listo! Te avisamos al vencimiento</h3>
      <p id="cgmConfirmMsg">Guardamos tu recordatorio. Ahora te llevamos al portal para completar la apertura de tu CDT.</p>
      <button class="cgm-btn-goto" id="cgmBtnIr">Ir al banco ↗</button>
    </div>

  </div>
</div>

<!-- ══════════════════════════════════════ -->
<!--  JAVASCRIPT                           -->
<!-- ══════════════════════════════════════ -->
<script>
(function() {

  /* ── Configuración ── */
  var GAS_TASAS = 'https://script.google.com/macros/s/AKfycbxAhQW4r5tJe-zugLBgiVDszaeC-G9sdqE-6NPW-u_Ts0zIMf4864Swk4V-nRuxmG-3/exec';
  var GAS_LEADS = 'https://script.google.com/macros/s/AKfycbyvsX0067ZK5PNZ-FHgBVwMItAeXraXEPtcNr-HaCjAxWEyN53ZZYANmfHjdS6tvI5T0w/exec';
  var FUENTE    = 'https://cdtgo.com/comparador-cdts/';

  /* Popula con los links reales cuando los tengas:
     'Nombre exacto en ranking': 'https://banco.com/cdt' */
  var LINKS = {
    'Banco Popular':        'https://www.bancopopular.com.co/wps/portal/bancopopular/inicio/para-ti/productos-ahorro-inversion/cdt-digital?utm_source=google&utm_medium=CDT-PRS&utm_campaign=Duermetranquilo-performance-searchmarca-CPA-2026&utm_content=CDT&gad_source=1&gad_campaignid=22594075145&gbraid=0AAAAA_GTZllu_Wvz9brnlODcaQz_HkO_a&gclid=CjwKCAjwoOjVBhArEiwAUwDakzTeRiHWQrSAjI0yzyFVjOhUqUbHQ6IC7dXjQRazYfV-BkPGGOiHyRoC1TwQAvD_BwE',
    'Banco W':              'https://cdtdigital.bancow.com.co/',
    'Davivienda':           'https://www.davivienda.com/personas/inversiones/cdt#app',
    'Banco Pichincha':      'https://www.pibank.co/cdt-pibank/',
    'Banco Finandina':      'https://www.bancofinandina.com/productos/cdts/cdt-virtual',
    'Mundo Mujer':          'https://www.bmm.com.co/cuentas-de-ahorro/cdt-progrese',
    'Koa CF':               'https://koa.co/cdt/',
     'Caja Social':         'https://digital.bancocajasocial.com/cdt',
     'Av Villas':           'https://www.avvillas.com.co/abrir-cdt-avvillas/',
     'Banco de Bogotá':      'https://cdtdigital.bancodebogota.com.co/?utm_source=google&utm_medium=search&utm_campaign=cdt-gg-sr-br-ccn-bdb26091b_cdt_col_gg_sr_aonfresh_est_sep_2026&utm_content=estatica&utm_term=bdb26091b_cdt_col_gg_sr_aonfresh_est_sep_2026&gad_source=1&gad_campaignid=21908707660&gbraid=0AAAAABPw3kyjx7FmfrsEiP46pllMgJl2x&gclid=CjwKCAjww-3VBhAcEiwAwUUIu46MD8FcbPVGlrK6BTQyRzZZ3Ptf6VJcTvkRGAUzzcyrBTZtekb6tBoC5zEQAvD_BwE',
     'Serfinanza':          'https://bancoserfinanza.com/personas/cdt-digital/',
     'Mibanco':             'https://www.mibanco.com.co/simuladores/cdt',
     'Tuya':                'https://www.tuya.com.co/cdt',
     'Credifamilia':        'https://cdt.credifamilia.com/?utm_source=Google&utm_campaign=mejor_cdt&utm_medium=comparacion_cdt&utm_term=comparar%20cdt&gad_source=1&gad_campaignid=24273027254&gbraid=0AAAAADmJlRWnjeZV8tFTYtA3V-o-w6Iex&gclid=Cj0KCQjw5vLVBhCiARIsAD56SFLXs8OjfxHRntP-YeU9jfVCNs29e47FR86c4XETzsWrlrRTRInqL9gaAryREALw_wcB',
      'Coltefinanciera':      'https://www.coltefinanciera.com.co/cdt/',
      'Banco Unión':          'https://www.bancounion.com/publicaciones/482/cdt/',
      'Banco Contactar':      'https://bancocontactar.com/cdt-productivo-online/',
      'Banco de Occidente':   'https://www.bancodeoccidente.com.co/inversion/cdt',
      'GNB Sudameris':        'https://www.gnbsudameris.com.co/gnb-premier/ahorro-inversion/premier-inversiones#online',
      'Bold CF':              'https://bold.co/cf/cdt',
      'Financiera Juriscoop C.f.': 'https://www.financierajuriscoop.com.co/personas/portafolio/ahorro-e-inversion/cdt',
      'Iris CF':            'https://iris.com.co/cdt/',
      'Banco Santander':    'https://www.cdt.santander.com.co/cdt-simulador',
      'Bancamía':           'https://www.bancamia.com.co/productos/cdt/',
      'Credifinanciera':    'https://www.ban100.com.co/productos/cdt',
      'Bancolombia':        'https://www.bancolombia.com/personas/productos/inversiones/simulador-inversion-virtual',
      'Colpatria':          'https://www.davibank.com/cdt',
      'Falabella':          'https://www.bancofalabella.com.co/cdt',
      'Crezcamos':          'https://crezcamos.com/ahorro-e-inversion/cdt-que-es/',
      'Coopcentral':        'https://www.coopcentral.com.co/index.asp?id_pagina=271.',
      'Lulo Bank S.a.':     'https://www.lulobank.com/',
      'BBVA':               'https://www.bbva.com.co/personas/productos/inversion/cdt/online.html',
      'Nu Bank':            'https://blog.nu.com.co/cdt-nu-haz-que-tu-dinero-crezca/',
      'Bancoomeva':         'https://www.bancoomeva.com.co/banca_cooperativa/publicaciones/163577/cdt/',
      'Banco Agrario':      'https://www.bancoagrario.gov.co/personas/asalariado-independiente-pensionado/inversion-cdt',
      'Coop. JFK':          'https://www.jfk.com.co/cdt-desmaterializado/?_gl=1*16jxntf*_gcl_au*MTE4NzU5NDE4LjE3OTA5MDYwMzM.',
      'Cooperativa Financiera de Antioquia':      'https://www.cfa.com.co/personas/cdts/cdt-cfa/',
      'Confiar':            'https://www.confiar.coop/simulador/simulador-cdt/',
      'Cotrafa':            'https://www.cotrafa.com.co/simuladores/simuladores-de-ahorro/simulador-de-cdt/',
      'La Hipotecaria':      'https://cdts.lahipotecaria.com/?_gl=1*704p70*_gcl_au*MTYzMDg1NTQ2NC4xNzkwOTA2NDk0*_ga*NjU2MDM2OTQ2LjE3OTA5MDY0OTM.*_ga_51N0XF7VRS*czE3OTA5MDY0OTQkbzEkZzAkdDE3OTA5MDY0OTQkajYwJGwwJGgw', 
      'Corficolombiana':      'https://www.corfi.com/es/lineas-de-negocio/tesoreria/productos-de-inversion-y-operaciones-del-mercado-monetario/cdt',
      'Plata. S.a. Compañía de Financiamiento':            'https://plata.co/es/cdt',  
  };

  var TOP_N     = 10;
  var DATA      = null;
  var plazo     = 'A 90 DIAS';
  var modo      = 'actual';
  var expandido = false;

  /* ── Estado del modal ── */
  var cgmCtx = { entidad: '', tasa: '', plazo: '', link: '' };

  /* ════════════════════════════════════════
     COMPARADOR — carga y render
  ════════════════════════════════════════ */
  function cargar() {
    fetch(GAS_TASAS, { redirect: 'follow' })
      .then(function(r){ return r.json(); })
      .then(function(d){ DATA = d; renderizar(); })
      .catch(function(){
        document.getElementById('cgTbody').innerHTML =
          '<tr><td colspan="5"><div class="cg-estado">Error al cargar. Intenta recargar la página.</div></td></tr>';
      });
  }

  function calcRanking() {
    if (!DATA || !DATA.series) return [];
    var rows = [];
    Object.keys(DATA.series).forEach(function(ent) {
      var serie = DATA.series[ent][plazo];
      if (!serie || serie.length === 0) return;
      var actual = serie[serie.length - 1].tasa;
      var prom30 = parseFloat((serie.reduce(function(s,p){ return s + p.tasa; }, 0) / serie.length).toFixed(2));
      rows.push({ entidad: ent, actual: actual, prom30: prom30 });
    });
    var sortKey = modo === 'actual' ? 'actual' : 'prom30';
    rows.sort(function(a, b){ return b[sortKey] - a[sortKey]; });
    return rows;
  }

  function plazoLabel(p) {
    if (p === 'A 90 DIAS')  return '90 días';
    if (p === 'A 180 DIAS') return '180 días';
    if (p === 'A 360 DIAS') return '360 días';
    return p;
  }

  function renderizar() {
    var ranking = calcRanking();
    var total   = ranking.length;

    if (total === 0) {
      document.getElementById('cgTbody').innerHTML =
        '<tr><td colspan="5"><div class="cg-estado">Sin datos para este plazo.</div></td></tr>';
      document.getElementById('cgVerWrap').style.display = 'none';
      return;
    }

    var key  = modo === 'actual' ? 'actual' : 'prom30';
    var maxVal = ranking[0][key];
    var colA = modo === 'actual' ? 'Tasa actual'   : 'Prom. 30 días';
    var colB = modo === 'actual' ? 'Prom. 30d'     : 'Tasa actual';

    document.getElementById('cgThead').innerHTML = '<tr>'
      + '<th>#&nbsp;&nbsp;Entidad</th>'
      + '<th class="cg-r">' + colA + '</th>'
      + '<th class="cg-r">' + colB + '</th>'
      + '<th class="cg-r" style="min-width:90px">Rel. mercado</th>'
      + '<th class="cg-c" style="min-width:110px">Abrir CDT</th>'
      + '</tr>';

    var filas = ranking.map(function(row, i) {
      var rank    = i + 1;
      var rankCls = rank === 1 ? 'cg-r1' : rank === 2 ? 'cg-r2' : rank === 3 ? 'cg-r3' : 'cg-rn';
      var pct     = Math.round((row[key] / maxVal) * 100);
      var esExtra = rank > TOP_N;
      var v1      = modo === 'actual' ? row.actual : row.prom30;
      var v2      = modo === 'actual' ? row.prom30 : row.actual;
      var link    = LINKS[row.entidad] || '';
      var tasaStr = v1.toFixed(2) + '%';
      var btnHtml = link
        ? '<button class="cg-btn cg-btn-on" '
            + 'data-ent="' + row.entidad.replace(/"/g,'&quot;') + '" '
            + 'data-tasa="' + tasaStr + '" '
            + 'data-plazo="' + plazoLabel(plazo) + '" '
            + 'data-link="' + link.replace(/"/g,'&quot;') + '" '
            + 'onclick="cgmAbrir(this)">Abrir CDT ↗</button>'
        : '<button class="cg-btn cg-btn-off" disabled>Próximamente</button>';

      return '<tr class="' + (esExtra ? 'cg-extra' : '') + '">'
        + '<td><div class="cg-ent-cell">'
        + '<span class="cg-rank ' + rankCls + '">' + rank + '</span>'
        + '<span class="cg-ent-name">' + row.entidad + '</span>'
        + '</div></td>'
        + '<td class="cg-r"><span class="cg-tasa-hi">' + v1.toFixed(2) + '%</span></td>'
        + '<td class="cg-r"><span class="cg-tasa-sec">' + v2.toFixed(2) + '%</span></td>'
        + '<td class="cg-r"><div class="cg-bar-wrap"><div class="cg-bar-fill" style="width:' + pct + '%"></div></div></td>'
        + '<td class="cg-c">' + btnHtml + '</td>'
        + '</tr>';
    }).join('');

    document.getElementById('cgTbody').innerHTML = filas;

    if (expandido) {
      document.querySelectorAll('.cg-extra').forEach(function(tr){ tr.classList.add('visible'); });
    }

    var verWrap = document.getElementById('cgVerWrap');
    if (total > TOP_N) {
      verWrap.style.display = 'block';
      actualizarBtnVer(total);
    } else {
      verWrap.style.display = 'none';
    }

    if (DATA.corte) {
      document.getElementById('cgFooter').innerHTML =
        '<span>📊 Fuente: datos.gov.co · Superintendencia Financiera de Colombia</span>'
        + '<span>⚙️ Cálculos propios CDTgo · Corte: ' + DATA.corte + '</span>';
    }
  }

  function actualizarBtnVer(total) {
    var txt  = document.getElementById('cgVerTxt');
    var btn  = document.getElementById('cgBtnVer');
    var rest = total - TOP_N;
    if (expandido) {
      txt.textContent = 'Ver solo Top 10';
      btn.classList.add('expandido');
    } else {
      txt.textContent = 'Ver ranking completo (' + rest + ' entidades más)';
      btn.classList.remove('expandido');
    }
  }

  document.getElementById('cgBtnVer').addEventListener('click', function() {
    expandido = !expandido;
    document.querySelectorAll('.cg-extra').forEach(function(tr){
      tr.classList.toggle('visible', expandido);
    });
    actualizarBtnVer(calcRanking().length);
  });

  document.querySelectorAll('.cg-tab').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.cg-tab').forEach(function(b){ b.classList.remove('active'); });
      btn.classList.add('active');
      plazo = btn.dataset.plazo;
      expandido = false;
      renderizar();
    });
  });

  document.querySelectorAll('.cg-tog').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.cg-tog').forEach(function(b){ b.classList.remove('active'); });
      btn.classList.add('active');
      modo = btn.dataset.modo;
      expandido = false;
      document.getElementById('cgMetodoActual').classList.toggle('cg-hidden', modo !== 'actual');
      document.getElementById('cgMetodoProm30').classList.toggle('cg-hidden', modo !== 'prom30');
      renderizar();
    });
  });

  /* ════════════════════════════════════════
     MODAL — apertura
  ════════════════════════════════════════ */
  window.cgmAbrir = function(btn) {
    cgmCtx.entidad = btn.dataset.ent;
    cgmCtx.tasa    = btn.dataset.tasa;
    cgmCtx.plazo   = btn.dataset.plazo;
    cgmCtx.link    = btn.dataset.link;

    /* Llenar datos en el modal */
    document.getElementById('cgmEntidad').textContent  = cgmCtx.entidad;
    document.getElementById('cgmTasaPlazo').textContent = cgmCtx.tasa + ' EA · ' + cgmCtx.plazo;
    document.getElementById('cgmPlazo').value           = cgmCtx.plazo;

    /* Resetear a vista de formulario */
    document.getElementById('cgmFormView').style.display    = 'block';
    document.getElementById('cgmConfirmView').style.display = 'none';
    document.getElementById('cgmBtnGuardar').disabled       = false;
    document.getElementById('cgmBtnGuardar').textContent    = 'Guardar y continuar al banco ↗';

    /* Abrir overlay */
    document.getElementById('cgmOverlay').classList.add('cgm-open');
    document.body.style.overflow = 'hidden';
  };

  /* Cerrar al hacer clic fuera del modal */
  document.getElementById('cgmOverlay').addEventListener('click', function(e) {
    if (e.target === this) cgmCerrar();
  });

  function cgmCerrar() {
    document.getElementById('cgmOverlay').classList.remove('cgm-open');
    document.body.style.overflow = '';
  }

  /* ════════════════════════════════════════
     MODAL — envío de lead
  ════════════════════════════════════════ */
  document.getElementById('cgmBtnGuardar').addEventListener('click', function() {
    var nombre   = document.getElementById('cgmNombre').value.trim();
    var apellido = document.getElementById('cgmApellido').value.trim();
    var email    = document.getElementById('cgmEmail').value.trim();

    if (!nombre || !apellido || !email) {
      alert('Por favor completa Nombre, Apellido y Correo electrónico.');
      return;
    }

    var btn = this;
    btn.disabled = true;
    btn.textContent = 'Guardando…';

    var payload = {
      entidad:              cgmCtx.entidad,
      plazo:                cgmCtx.plazo,
      tasa:                 cgmCtx.tasa,
      nombre:               nombre,
      apellido:             apellido,
      email:                email,
      celular:              document.getElementById('cgmCelular').value.trim(),
      monto:                document.getElementById('cgmMonto').value.trim(),
      consent_recordatorio: document.getElementById('cgmC1').checked,
      consent_marketing:    document.getElementById('cgmC2').checked,
      consent_disclaimer:   document.getElementById('cgmC3').checked,
      tipo:                 'lead',
      fuente:               FUENTE
    };

    fetch(GAS_LEADS, {
      method:      'POST',
      mode:        'no-cors',
      headers:     { 'Content-Type': 'text/plain' },
      body:        JSON.stringify(payload)
    })
    .catch(function(){})
    .finally(function() {
      /* Mostrar confirmación y habilitar botón ir al banco */
      document.getElementById('cgmFormView').style.display    = 'none';
      document.getElementById('cgmConfirmView').style.display = 'block';
      document.getElementById('cgmConfirmMsg').innerHTML =
        'Guardamos tu recordatorio. Ahora te llevamos al portal de <strong>' + cgmCtx.entidad + '</strong>.';
      document.getElementById('cgmBtnIr').textContent = 'Ir a ' + cgmCtx.entidad + ' ↗';
    });
  });

  /* ════════════════════════════════════════
     MODAL — saltar sin registrarse
  ════════════════════════════════════════ */
  document.getElementById('cgmBtnSaltar').addEventListener('click', function() {
    /* Registrar clic anónimo en el GAS (fire & forget) */
    fetch(GAS_LEADS, {
      method:  'POST',
      mode:    'no-cors',
      headers: { 'Content-Type': 'text/plain' },
      body:    JSON.stringify({
        entidad: cgmCtx.entidad,
        plazo:   cgmCtx.plazo,
        tasa:    cgmCtx.tasa,
        tipo:    'click_anonimo',
        fuente:  FUENTE
      })
    }).catch(function(){});

    cgmCerrar();
    window.open(cgmCtx.link, '_blank', 'noopener');
  });

  /* Botón "Ir al banco" en confirmación */
  document.getElementById('cgmBtnIr').addEventListener('click', function() {
    cgmCerrar();
    window.open(cgmCtx.link, '_blank', 'noopener');
  });

  /* ════════════════════════════════════════
     INICIO
  ════════════════════════════════════════ */
  cargar();

})();
</script>
