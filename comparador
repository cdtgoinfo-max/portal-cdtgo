<style>
.cdtgo-comp {
  --bg:     #0f0d1c;
  --card:   #1a1730;
  --border: #2e2a50;
  --purple: #7c5cfc;
  --cyan:   #4fc3f7;
  --green:  #4ade80;
  --text:   #e2e0f0;
  --muted:  #a09ec0;
  --dim:    #6b6988;
  --gold:   #f59e0b;

  font-family: 'Inter', -apple-system, sans-serif;
  background: var(--bg);
  color: var(--text);
  border-radius: 16px;
  padding: 32px 20px 48px;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

/* Halftone */
.cdtgo-comp::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: radial-gradient(circle, rgba(255,255,255,0.055) 2px, transparent 2px);
  background-size: 22px 22px;
  pointer-events: none;
  z-index: 0;
}

.cdtgo-comp *, .cdtgo-comp *::before, .cdtgo-comp *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

.cdtgo-comp .cg-wrap {
  max-width: 900px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

/* ── HEADER ── */
.cdtgo-comp .cg-hdr {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 4px;
}
.cdtgo-comp .cg-logo {
  width: 36px; height: 36px;
  background: var(--purple);
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-weight: 800; font-size: 1rem; color: #fff;
  flex-shrink: 0;
}
.cdtgo-comp .cg-brand { font-size: 1.1rem; font-weight: 700; color: var(--text); }
.cdtgo-comp .cg-brand span { color: var(--purple); }
.cdtgo-comp .cg-subtitle {
  font-size: 0.8rem;
  color: var(--dim);
  margin-bottom: 28px;
  padding-left: 48px;
}

/* ── CONTROLES ── */
.cdtgo-comp .cg-controles {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: center;
  margin-bottom: 20px;
}
.cdtgo-comp .cg-tabs { display: flex; gap: 8px; flex-wrap: wrap; }
.cdtgo-comp .cg-tab {
  padding: 7px 20px;
  border-radius: 999px;
  border: 1px solid var(--border);
  background: transparent;
  color: var(--muted);
  font-size: 0.85rem;
  font-weight: 500;
  cursor: pointer;
  transition: all .18s;
  font-family: inherit;
  line-height: 1.4;
}
.cdtgo-comp .cg-tab:hover { border-color: var(--purple); color: var(--text); }
.cdtgo-comp .cg-tab.active { background: var(--purple); border-color: var(--purple); color: #fff; }

.cdtgo-comp .cg-toggle-wrap {
  display: flex;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 4px;
  width: fit-content;
}
.cdtgo-comp .cg-tog {
  padding: 7px 16px;
  border-radius: 7px;
  border: none;
  background: transparent;
  color: var(--muted);
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
  transition: all .18s;
  font-family: inherit;
  white-space: nowrap;
  line-height: 1.4;
}
.cdtgo-comp .cg-tog.active { background: var(--purple); color: #fff; }

/* ── METODOLOGÍA ── */
.cdtgo-comp .cg-metodo-box {
  background: rgba(124,92,252,0.08);
  border: 1px solid rgba(124,92,252,0.25);
  border-radius: 10px;
  padding: 12px 16px;
  font-size: 0.78rem;
  color: var(--muted);
  line-height: 1.6;
  margin-bottom: 20px;
}
.cdtgo-comp .cg-metodo-box strong { color: var(--purple); }
.cdtgo-comp .cg-metodo-box .cg-hl { color: var(--cyan); font-weight: 600; }
.cdtgo-comp .cg-metodo-box.cg-hidden { display: none; }

/* ── SCROLL HINT ── */
.cdtgo-comp .cg-scroll-hint {
  display: none;
  text-align: center;
  font-size: 0.72rem;
  color: var(--dim);
  padding: 6px 0 2px;
  letter-spacing: 0.03em;
}

/* ── TABLA ── */
.cdtgo-comp .cg-table-wrap {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
}
.cdtgo-comp table {
  width: 100%;
  border-collapse: collapse;
  border-spacing: 0;
}
.cdtgo-comp thead th {
  padding: 13px 14px;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--dim);
  background: #13112a;
  text-align: left;
  border-bottom: 1px solid var(--border);
  white-space: nowrap;
}
.cdtgo-comp thead th.cg-r { text-align: right; }
.cdtgo-comp thead th.cg-c { text-align: center; }

.cdtgo-comp tbody tr {
  border-bottom: 1px solid #1e1c38;
  transition: background .12s;
}
.cdtgo-comp tbody tr:last-child { border-bottom: none; }
.cdtgo-comp tbody tr:hover { background: rgba(124,92,252,0.06); }
.cdtgo-comp tbody tr.cg-extra { display: none; }
.cdtgo-comp tbody tr.cg-extra.visible { display: table-row; }

.cdtgo-comp td {
  padding: 13px 14px;
  font-size: 0.88rem;
  color: var(--text);
  vertical-align: middle;
}
.cdtgo-comp td.cg-r { text-align: right; }
.cdtgo-comp td.cg-c { text-align: center; }

.cdtgo-comp .cg-rank {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 24px; height: 24px;
  border-radius: 6px;
  font-size: 0.75rem;
  font-weight: 700;
  margin-right: 10px;
  flex-shrink: 0;
}
.cdtgo-comp .cg-r1 { background: rgba(245,158,11,0.18); color: var(--gold); }
.cdtgo-comp .cg-r2 { background: rgba(226,232,240,0.12); color: #cbd5e1; }
.cdtgo-comp .cg-r3 { background: rgba(180,100,50,0.15);  color: #cd7c4a; }
.cdtgo-comp .cg-rn { background: rgba(255,255,255,0.05); color: var(--dim); }

.cdtgo-comp .cg-ent-cell { display: flex; align-items: center; }
.cdtgo-comp .cg-ent-name { font-weight: 600; color: var(--text); }

.cdtgo-comp .cg-tasa-hi  { font-weight: 700; font-size: 0.98rem; color: var(--green); font-variant-numeric: tabular-nums; }
.cdtgo-comp .cg-tasa-sec { font-weight: 500; color: var(--muted); font-variant-numeric: tabular-nums; }

.cdtgo-comp .cg-bar-wrap {
  width: 100%; max-width: 100px;
  height: 5px;
  background: rgba(255,255,255,0.07);
  border-radius: 3px;
  margin-left: auto;
  overflow: hidden;
}
.cdtgo-comp .cg-bar-fill {
  height: 100%;
  border-radius: 3px;
  background: linear-gradient(90deg, var(--purple), var(--cyan));
  transition: width .4s ease;
}

/* ── BOTÓN ABRIR CDT ── */
.cdtgo-comp .cg-btn {
  display: inline-block;
  padding: 5px 13px;
  border-radius: 8px;
  font-size: 0.74rem;
  font-weight: 700;
  font-family: inherit;
  cursor: pointer;
  text-decoration: none;
  transition: all .18s;
  white-space: nowrap;
  border: none;
  line-height: 1.5;
}
.cdtgo-comp .cg-btn-on {
  background: linear-gradient(135deg, var(--purple), #5b3fd4);
  color: #fff;
  box-shadow: 0 2px 10px rgba(124,92,252,0.35);
}
.cdtgo-comp .cg-btn-on:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 16px rgba(124,92,252,0.5);
  color: #fff;
}
.cdtgo-comp .cg-btn-off {
  background: rgba(255,255,255,0.04);
  color: var(--dim);
  cursor: default;
  border: 1px solid var(--border);
}

/* ── VER TODO ── */
.cdtgo-comp .cg-ver-wrap {
  text-align: center;
  padding: 18px;
  border-top: 1px solid var(--border);
}
.cdtgo-comp .cg-btn-ver {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 9px 24px;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: transparent;
  color: var(--muted);
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
  font-family: inherit;
  transition: all .18s;
  line-height: 1.4;
}
.cdtgo-comp .cg-btn-ver:hover {
  border-color: var(--purple);
  color: var(--text);
  background: rgba(124,92,252,0.08);
}
.cdtgo-comp .cg-btn-ver .cg-ico { transition: transform .25s; display: inline-block; }
.cdtgo-comp .cg-btn-ver.expandido .cg-ico { transform: rotate(180deg); }

/* ── LOADING / ERROR ── */
.cdtgo-comp .cg-estado {
  text-align: center;
  padding: 48px 20px;
  color: var(--dim);
  font-size: 0.9rem;
}
.cdtgo-comp .cg-spinner {
  width: 26px; height: 26px;
  border: 3px solid var(--border);
  border-top-color: var(--purple);
  border-radius: 50%;
  animation: cgSpin .7s linear infinite;
  margin: 0 auto 14px;
}
@keyframes cgSpin { to { transform: rotate(360deg); } }

/* ── FOOTER ── */
.cdtgo-comp .cg-footer {
  margin-top: 20px;
  font-size: 0.73rem;
  color: var(--dim);
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 6px;
}

/* ── MOBILE ── */
@media (max-width: 620px) {
  .cdtgo-comp .cg-controles { flex-direction: column; align-items: flex-start; }
  .cdtgo-comp .cg-scroll-hint { display: block; }
  .cdtgo-comp .cg-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--purple) var(--card);
  }
  .cdtgo-comp .cg-table-wrap::-webkit-scrollbar { height: 4px; }
  .cdtgo-comp .cg-table-wrap::-webkit-scrollbar-track { background: var(--card); }
  .cdtgo-comp .cg-table-wrap::-webkit-scrollbar-thumb { background: var(--purple); border-radius: 2px; }
  .cdtgo-comp table { min-width: 580px; }
  .cdtgo-comp td, .cdtgo-comp thead th { padding: 10px 10px; font-size: 0.8rem; white-space: nowrap; }
  .cdtgo-comp .cg-btn { padding: 5px 10px; font-size: 0.7rem; }
  .cdtgo-comp .cg-rank { margin-right: 6px; width: 20px; height: 20px; font-size: 0.7rem; }
}

/* ════════════════════════════════════════════
   MODAL DE LEADS
   ════════════════════════════════════════════ */
.cgm-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(8,6,20,0.78);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  z-index: 99999;
  align-items: center;
  justify-content: center;
  padding: 20px;
  font-family: 'Inter', -apple-system, sans-serif;
}
.cgm-overlay.cgm-open { display: flex; }

.cgm-modal {
  background: #13112a;
  border: 1px solid #2e2a50;
  border-radius: 20px;
  width: 100%;
  max-width: 420px;
  padding: 32px 28px 28px;
  position: relative;
  box-shadow: 0 24px 64px rgba(0,0,0,0.65), 0 0 0 1px rgba(124,92,252,0.15);
  max-height: 90vh;
  overflow-y: auto;
}
/* Línea de acento + halftone */
.cgm-modal::before {
  content: '';
  position: absolute;
  top: 0; left: 28px; right: 28px;
  height: 2px;
  background: linear-gradient(90deg, #7c5cfc, #4fc3f7);
  border-radius: 0 0 2px 2px;
}
.cgm-modal::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 20px;
  background-image: radial-gradient(circle, rgba(255,255,255,0.055) 2px, transparent 2px);
  background-size: 22px 22px;
  pointer-events: none;
  z-index: 0;
}
.cgm-modal > * { position: relative; z-index: 1; }

/* Logo */
.cgm-logo { display: flex; align-items: center; gap: 8px; margin-bottom: 20px; }
.cgm-logo-box {
  width: 28px; height: 28px;
  background: #7c5cfc;
  border-radius: 7px;
  display: flex; align-items: center; justify-content: center;
  font-weight: 800; font-size: 0.8rem; color: #fff;
  flex-shrink: 0;
}
.cgm-logo-brand { font-size: 0.9rem; font-weight: 700; color: #e2e0f0; }
.cgm-logo-brand span { color: #7c5cfc; }

/* Destino */
.cgm-dest {
  background: rgba(79,195,247,0.07);
  border: 1px solid rgba(79,195,247,0.2);
  border-radius: 10px;
  padding: 10px 14px;
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 22px;
}
.cgm-dest-ico {
  width: 32px; height: 32px;
  background: rgba(79,195,247,0.12);
  border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1rem; flex-shrink: 0;
}
.cgm-dest-label { font-size: 0.7rem; color: #6b6988; font-weight: 500; }
.cgm-dest-name  { font-size: 0.9rem; font-weight: 700; color: #e2e0f0; }
.cgm-dest-tasa  { font-size: 0.78rem; color: #4ade80; font-weight: 600; margin-left: auto; white-space: nowrap; }

/* Título y subtítulo */
.cgm-title {
  font-size: 1.05rem;
  font-weight: 700;
  color: #fff;
  margin-bottom: 6px;
  text-wrap: balance;
  line-height: 1.4;
}
.cgm-sub {
  font-size: 0.8rem;
  color: #a09ec0;
  line-height: 1.6;
  margin-bottom: 20px;
}
.cgm-sub strong { color: #4fc3f7; }

/* Formulario */
.cgm-form { display: flex; flex-direction: column; gap: 11px; margin-bottom: 16px; }
.cgm-field { display: flex; flex-direction: column; gap: 4px; }
.cgm-field label {
  font-size: 0.71rem;
  font-weight: 600;
  color: #a09ec0;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.cgm-field input {
  background: #1a1730;
  border: 1px solid #2e2a50;
  border-radius: 10px;
  padding: 9px 13px;
  font-size: 0.87rem;
  color: #e2e0f0;
  font-family: inherit;
  outline: none;
  transition: border-color .15s;
  width: 100%;
}
.cgm-field input::placeholder { color: #6b6988; }
.cgm-field input:focus { border-color: #7c5cfc; }
.cgm-field input[readonly] { color: #4fc3f7; font-weight: 600; background: #13112a; cursor: default; }

.cgm-row { display: grid; grid-template-columns: 1fr 1fr; gap: 11px; }

/* Consentimientos */
.cgm-consents { display: flex; flex-direction: column; gap: 8px; margin-bottom: 18px; }
.cgm-consent {
  display: flex;
  align-items: flex-start;
  gap: 9px;
  font-size: 0.72rem;
  color: #6b6988;
  line-height: 1.5;
  cursor: pointer;
}
.cgm-consent input[type=checkbox] {
  width: 15px; height: 15px;
  accent-color: #7c5cfc;
  flex-shrink: 0;
  margin-top: 1px;
  cursor: pointer;
}
.cgm-habeas {
  font-size: 0.67rem;
  color: #6b6988;
  padding-left: 24px;
  line-height: 1.5;
  margin-top: 2px;
}

/* Botones */
.cgm-actions { display: flex; flex-direction: column; gap: 8px; }
.cgm-btn-primary {
  width: 100%;
  padding: 12px;
  border-radius: 11px;
  border: none;
  background: linear-gradient(135deg, #7c5cfc, #5b3fd4);
  color: #fff;
  font-size: 0.88rem;
  font-weight: 700;
  font-family: inherit;
  cursor: pointer;
  box-shadow: 0 4px 18px rgba(124,92,252,0.4);
  transition: all .18s;
}
.cgm-btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 24px rgba(124,92,252,0.55); }
.cgm-btn-primary:disabled { opacity: 0.6; cursor: default; transform: none; }

.cgm-btn-skip {
  width: 100%;
  padding: 10px;
  border-radius: 11px;
  border: 1px solid #2e2a50;
  background: transparent;
  color: #6b6988;
  font-size: 0.77rem;
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
  transition: all .18s;
}
.cgm-btn-skip:hover { color: #a09ec0; border-color: #3d3860; }

/* Vista confirmación */
.cgm-confirm { display: none; text-align: center; padding: 8px 0; }
.cgm-check {
  width: 52px; height: 52px;
  border-radius: 50%;
  background: rgba(74,222,128,0.12);
  border: 2px solid rgba(74,222,128,0.3);
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 16px;
  font-size: 1.4rem;
  color: #4ade80;
}
.cgm-confirm h3 { font-size: 1rem; font-weight: 700; color: #fff; margin-bottom: 8px; }
.cgm-confirm p  { font-size: 0.82rem; color: #a09ec0; line-height: 1.6; margin-bottom: 20px; }
.cgm-btn-goto {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 11px 28px;
  border-radius: 11px;
  border: none;
  background: linear-gradient(135deg, #7c5cfc, #5b3fd4);
  color: #fff;
  font-size: 0.88rem;
  font-weight: 700;
  font-family: inherit;
  cursor: pointer;
  box-shadow: 0 4px 18px rgba(124,92,252,0.4);
  transition: all .18s;
}
.cgm-btn-goto:hover { transform: translateY(-1px); }

@media (max-width: 480px) {
  .cgm-modal { padding: 28px 18px 22px; }
  .cgm-row { grid-template-columns: 1fr; }
}
</style>

